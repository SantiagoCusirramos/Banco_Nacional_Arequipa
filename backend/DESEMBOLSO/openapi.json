    "/api/v1/ordenes/{id_orden}/confirmacion": {
      "post": {
        "tags": [
          "Órdenes de desembolso"
        ],
        "summary": "Confirmar: abonar, crear el crédito y desembolsar la solicitud",
        "description": "Una sola operación de COREDB: el abono, el crédito AL_DIA con su calendario OFICIAL y la\nsolicitud DESEMBOLSADA. Si se pierde la respuesta, se repite: devuelve lo mismo sin otro abono.",
        "operationId": "confirmar_api_v1_ordenes__id_orden__confirmacion_post",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id_orden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id Orden"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "200": {
            "description": "Ya estaba confirmada: el mismo crédito y el mismo abono"
          },
          "422": {
            "description": "ORDEN_NO_ADMITIDA, APROBACION_NO_VIGENTE, VALIDACION_NO_ADMITIDA o CUENTA_NO_ELEGIBLE"
          }
        }
      }
    },
