            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "PREPARADA",
                    "VALIDADA",
                    "EN_PROCESO",
                    "POR_VERIFICAR",
                    "CONFIRMADA",
                    "RECHAZADA",
                    "REVERTIDA"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Estado"
            }
          },
          {
            "name": "codCliente",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
