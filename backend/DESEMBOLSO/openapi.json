{
  "openapi": "3.1.0",
  "info": {
    "title": "BNA · Desembolso de Créditos",
    "description": "Módulo 13 de la Línea de Créditos, sin base propia. El operador verifica el documento del titular, elige una aprobación vigente (leída de COREDB, CR-INT-04) y una cuenta de ahorros individual del titular, prepara la orden, registra la identidad del día y confirma. COREDB abona, crea el crédito con su calendario oficial y deja la solicitud DESEMBOLSADA en una sola operación; confirmar otra vez devuelve lo mismo sin otro abono. Lo que hace la persona va con su token de COREDB, que Desembolso reenvía. Montos como texto decimal (\"15000.00\").",
    "version": "2.0.0"
  },
  "paths": {
    "/salud": {
      "get": {
        "tags": [
          "Estado"
        ],
        "summary": "COREDB responde y el usuario de servicio inicia sesión",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
