            "Bearer": []
          }
        ]
      }
    },
    "/api/v1/identidad": {
      "post": {
        "tags": [
          "Operación en agencia"
        ],
        "summary": "Verificar el documento del titular en ventanilla",
        "description": "El operador revisó el documento original y a la persona. COREDB registra la verificación y\nla aprueba solo para un cliente ACTIVO; su `idValidacion` es la evidencia IDENTIDAD de la orden,\nválida el mismo día (fecha de Lima). Sin identidad verificada, la respuesta no dice si el\ndocumento es de un cliente.",
        "operationId": "verificar_identidad_api_v1_identidad_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentidadIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "403": {
            "description": "PERMISO_DENEGADO"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/api/v1/aprobaciones": {
      "get": {
        "tags": [
          "Operación en agencia"
        ],
        "summary": "Aprobaciones vigentes sin desembolso (CR-INT-04)",
        "description": "Se leen de COREDB con el usuario de servicio: la última ronda aprobada, dentro de sus 30 días\ny sin desembolso confirmado, con el calendario de Solicitud sin cambios. `ordenAbierta` es la\norden PREPARADA o VALIDADA que ya tiene, si la hay.",
        "operationId": "aprobaciones_api_v1_aprobaciones_get",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "codCliente",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12,
                  "pattern": "^[A-Za-z0-9]+$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Codcliente"
            }
          },
          {
            "name": "idSolicitud",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idsolicitud"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "FILTRO_REQUERIDO: indica codCliente o idSolicitud"
          }
        }
      }
    },
    "/api/v1/clientes/{cod_cliente}/cuentas": {
      "get": {
        "tags": [
          "Operación en agencia"
        ],
        "summary": "Cuentas del titular y si admiten el abono",
        "description": "Las cuentas en las que el cliente es titular, leídas de COREDB con el usuario de servicio. Solo\nadmite el abono una cuenta de ahorros INDIVIDUAL, ACTIVA, del titular y en la moneda del crédito;\n`motivo` dice por qué otra no: CUENTA_MANCOMUNADA, TITULAR_DISTINTO, CUENTA_NO_ACTIVA o\nMONEDA_DISTINTA.",
        "operationId": "cuentas_api_v1_clientes__cod_cliente__cuentas_get",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "cod_cliente",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12,
              "pattern": "^[A-Za-z0-9]+$",
              "title": "Cod Cliente"
            }
          },
          {
            "name": "moneda",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Moneda"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes": {
      "post": {
        "tags": [
          "Órdenes de desembolso"
        ],
        "summary": "Preparar la orden de una aprobación",
        "description": "El importe es el monto aprobado. Se rechaza si la aprobación venció, si su primera cuota ya\nvenció, si ya tiene una orden abierta o si la cuenta no es elegible.",
        "operationId": "preparar_api_v1_ordenes_post",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrdenIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "200": {
            "description": "La misma llave con el mismo contenido: la misma orden"
          },
          "409": {
            "description": "IDEMPOTENCIA_CONFLICTO"
          },
          "422": {
            "description": "APROBACION_NO_VIGENTE, CALENDARIO_INVALIDO, ORDEN_NO_ADMITIDA o CUENTA_NO_ELEGIBLE"
          }
        }
      },
      "get": {
        "tags": [
          "Órdenes de desembolso"
        ],
        "summary": "Monitor de órdenes",
        "operationId": "monitor_api_v1_ordenes_get",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
