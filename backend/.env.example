# ============================================================
# BNA — Backend environment variables
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env al repositorio.
# ============================================================

# ── Aplicación ──────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── Base de datos (MySQL 8.0) ────────────────────────────────
DB_HOST=bna_mysql
DB_PORT=3306
HEAD
DB_NAME=bna

DB_NAME=bna                   # la base que crean los scripts SQL

DB_USER=bna_user
DB_PASSWORD=root

# ── Seguridad / JWT ──────────────────────────────────────────
# Obligatoria: sin una clave propia de al menos 32 caracteres, el backend no arranca.
# Genera la tuya con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=8132d277845b2b2d38c965621ab7541f55061f12
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Módulo CUENTAS (cliente de la API CORE) ─────────────────
CORE_BASE_URL=http://localhost:8000
CORE_TIMEOUT_SECONDS=5

# ── CORS (orígenes permitidos, separados por coma) ──────────
CORS_ORIGINS=http://localhost:3000

# ── Bus de Servicios ─────────────────────────────────────────
BUS_BASE_URL=http://localhost:9000   # URL interna del Bus de Servicios
BUS_TIMEOUT_SECONDS=3

# ── Primer usuario admin (solo para seeding inicial) ────────
ADMIN_EMAIL=admin@bna.pe
ADMIN_PASSWORD=change_me_admin_password
