# ============================================================
# BNA — Backend environment variables
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env al repositorio.
# ============================================================

# ── Aplicación ──────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── Base de datos (MySQL 8.0) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bna_db
DB_USER=bna_user
DB_PASSWORD=change_me_password

# URL construida automáticamente por SQLAlchemy si usas pydantic-settings,
# o la puedes definir manualmente:
# DATABASE_URL=mysql+pymysql://bna_user:change_me_password@localhost:3306/bna_db

# ── Seguridad / JWT ──────────────────────────────────────────
# Genera con: openssl rand -hex 32
SECRET_KEY=change_me_super_secret_key_32_chars_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS (orígenes permitidos, separados por coma) ──────────
CORS_ORIGINS=http://localhost:3000

# ── Bus de Servicios ─────────────────────────────────────────
BUS_BASE_URL=http://localhost:9000   # URL interna del Bus de Servicios
BUS_TIMEOUT_SECONDS=3

# ── Primer usuario admin (solo para seeding inicial) ────────
ADMIN_EMAIL=admin@bna.pe
ADMIN_PASSWORD=change_me_admin_password
