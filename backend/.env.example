# ============================================================
# BNA — Backend environment variables
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env al repositorio.
# ============================================================

# ── Aplicación ──────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── Base de datos (MySQL 8.0) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bna                   # la base que crean los scripts SQL
DB_USER=bna_user
DB_PASSWORD=change_me_password

# ── Seguridad / JWT ──────────────────────────────────────────
# Obligatoria: sin una clave propia de al menos 32 caracteres, el backend no arranca.
# Genera la tuya con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_super_secret_key_32_chars_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Módulos CUENTAS, TARJETAS y CAPTACION (clientes de COREDB) ───
# COREDB se alcanza a través del Bus de Servicios, nunca directo (fase 2).
# BUS_TOKEN es la credencial del módulo ante el Bus (X-Bus-Token). Evaluación y
# Desembolso leen la misma dirección de COREDB_URL.
CORE_BASE_URL=http://localhost:8018/bus/coredb
COREDB_URL=http://localhost:8018/bus/coredb
BUS_TOKEN=
CORE_TIMEOUT_SECONDS=5

# ── CORS (orígenes permitidos, separados por coma) ──────────
CORS_ORIGINS=http://localhost:3000

# ── Bus de Servicios ─────────────────────────────────────────
BUS_BASE_URL=http://localhost:8018   # Bus de Servicios (backend/BUS_SERVICIOS)
BUS_TIMEOUT_SECONDS=3

# ── Primer usuario admin (solo para seeding inicial) ────────
ADMIN_EMAIL=admin@bna.pe
ADMIN_PASSWORD=change_me_admin_password
