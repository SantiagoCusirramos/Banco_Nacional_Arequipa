{
  "components": {
    "schemas": {
      "BloqueoIn": {
        "additionalProperties": false,
        "properties": {
          "motivo": {
            "maxLength": 255,
            "minLength": 3,
            "title": "Motivo",
            "type": "string"
          }
        },
        "required": [
          "motivo"
        ],
        "title": "BloqueoIn",
        "type": "object"
      },
      "EmisionIn": {
        "additionalProperties": false,
        "properties": {
          "bin": {
            "default": "004499",
            "pattern": "^[0-9]{6}$",
            "title": "Bin",
            "type": "string"
          },
          "cod_cliente": {
            "maxLength": 12,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]+$",
            "title": "Cod Cliente",
            "type": "string"
          },
          "fecha_emision": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Hoy si no se envía.",
            "title": "Fecha Emision"
          },
          "fecha_vencimiento": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cuatro años después de la emisión si no se envía.",
            "title": "Fecha Vencimiento"
          },
          "num_cuenta": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Num Cuenta",
            "type": "string"
          },
          "ultimos4": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Los últimos cuatro dígitos del PAN. El PAN nunca se envía.",
            "title": "Ultimos4"
          }
        },
        "required": [
          "cod_cliente",
          "num_cuenta"
        ],
        "title": "EmisionIn",
        "type": "object"
      },
      "EstadoIn": {
        "additionalProperties": false,
        "properties": {
          "estado": {
            "enum": [
              "ACTIVA",
              "BLOQUEADA",
              "RETENIDA",
              "ANULADA"
            ],
            "title": "Estado",
            "type": "string"
          },
          "motivo": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Motivo"
          }
        },
        "required": [
          "estado"
        ],
        "title": "EstadoIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
