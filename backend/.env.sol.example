# Copiar como backend/.env.sol. Nunca guardar la copia con claves en Git.
SOL_DB_HOST=127.0.0.1
SOL_DB_PORT=3306
SOL_DB_USER=root
SOL_DB_PASSWORD=CAMBIA_POR_TU_CLAVE_MYSQL
SOL_DB_NAME=bna_sol_mvp
SOL_INTEGRATION_MODE=SIMULADO
# La clave inicial se solicita por consola durante python -m SOL.manage init.
# Para automatización local, se puede definir SOL_INITIAL_PASSWORD temporalmente.

# v2. REAL significa transporte HTTP configurado; no acredita integración aprobada.
# Mantener SIMULADO hasta contar con las rutas y credenciales del ambiente Testing.
# Las rutas de ejemplo están documentadas en CONTRATOS_HTTP_V2.md, no son oficiales.
SOL_BUS_BASE_URL=
SOL_BUS_TOKEN=
SOL_EVA_CALLBACK_TOKEN=
SOL_CAP_SEARCH_PATH=
SOL_CAP_REFERENCE_PATH=
SOL_EVA_SEND_PATH=
SOL_EVA_STATUS_PATH=
SOL_AUDIT_PATH=
# Timeout de cada fase HTTP, máximo dos reintentos adicionales (tres intentos).
SOL_HTTP_TIMEOUT_SECONDS=0.6
SOL_HTTP_MAX_RETRIES=2
SOL_REQUEST_BUDGET_SECONDS=2.4
# Intervalo entre ciclos del worker interno; 0 lo desactiva (pruebas/worker CLI).
SOL_WORKER_SECONDS=5
