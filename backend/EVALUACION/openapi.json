  "components": {
    "schemas": {
      "CalendarioSol": {
        "properties": {
          "estado": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Estado"
          },
          "cuotas": {
            "items": {
              "$ref": "#/components/schemas/CuotaSol"
            },
            "type": "array",
            "maxItems": 600,
            "minItems": 1,
            "title": "Cuotas"
          },
          "cuota_referencial": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Cuota Referencial"
          },
          "intereses_totales": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Intereses Totales"
          },
          "total_pagar": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Total Pagar"
          }
        },
        "type": "object",
        "required": [
          "estado",
          "cuotas",
          "cuota_referencial",
          "intereses_totales",
          "total_pagar"
        ],
        "title": "CalendarioSol"
      },
      "ClienteSol": {
        "properties": {
          "id_cliente": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Id Cliente"
          },
          "cod_tipo_documento": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Cod Tipo Documento",
            "default": "DNI"
          },
          "numero_documento": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Numero Documento"
          },
          "nombres": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Nombres"
          },
          "apellido_paterno": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Apellido Paterno"
          },
          "apellido_materno": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Apellido Materno"
          }
        },
        "type": "object",
        "required": [
          "id_cliente",
          "numero_documento",
          "nombres",
          "apellido_paterno"
        ],
        "title": "ClienteSol"
      },
      "CondicionesSol": {
        "properties": {
          "id_cliente": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Id Cliente"
          },
          "monto_solicitado": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Monto Solicitado"
          },
          "moneda": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ],
            "title": "Moneda"
          },
          "plazo_meses": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Plazo Meses"
          },
          "destino_credito": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Destino Credito"
          },
          "fecha_base": {
            "type": "string",
            "format": "date",
            "title": "Fecha Base"
          }
        },
        "type": "object",
        "required": [
          "id_cliente",
          "monto_solicitado",
          "moneda",
          "plazo_meses",
          "fecha_base"
        ],
        "title": "CondicionesSol"
      },
      "CuotaSol": {
        "properties": {
          "numero_cuota": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Numero Cuota"
          },
          "fecha_vencimiento": {
            "type": "string",
            "format": "date",
            "title": "Fecha Vencimiento"
          },
          "saldo_inicial": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Saldo Inicial"
          },
          "amortizacion": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amortizacion"
          },
          "interes": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Interes"
          },
          "cuota_total": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Cuota Total"
          },
          "saldo_final": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Saldo Final"
          }
        },
        "type": "object",
        "required": [
