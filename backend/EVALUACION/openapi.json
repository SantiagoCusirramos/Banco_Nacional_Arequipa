  "components": {
    "schemas": {
      "CalendarioSol": {
        "properties": {
          "cuotas": {
            "items": {
              "$ref": "#/components/schemas/CuotaSol"
            },
            "type": "array",
            "maxItems": 600,
            "minItems": 1,
            "title": "Cuotas"
          },
          "total_pagar": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Total Pagar"
          }
        },
        "type": "object",
        "required": [
          "cuotas",
          "total_pagar"
        ],
        "title": "CalendarioSol"
      },
      "ClienteSol": {
        "properties": {
          "id_cliente": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Id Cliente"
          }
        },
        "type": "object",
        "required": [
          "id_cliente"
        ],
        "title": "ClienteSol"
      },
      "CondicionesSol": {
        "properties": {
          "id_cliente": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Id Cliente"
          },
          "monto_solicitado": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Monto Solicitado"
          },
          "moneda": {
            "type": "string",
            "enum": [
              "PEN",
              "USD"
            ],
            "title": "Moneda"
          },
          "plazo_meses": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Plazo Meses"
          },
          "destino_credito": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Destino Credito"
          },
          "pago_doble": {
            "type": "boolean",
            "title": "Pago Doble",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id_cliente",
          "monto_solicitado",
          "moneda",
          "plazo_meses"
        ],
        "title": "CondicionesSol"
      },
      "CuotaSol": {
        "properties": {
          "numero_cuota": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Numero Cuota"
          },
          "fecha_vencimiento": {
            "type": "string",
            "format": "date",
            "title": "Fecha Vencimiento"
          },
          "saldo_inicial": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Saldo Inicial"
          },
          "amortizacion": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amortizacion"
          },
          "interes": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Interes"
          },
          "cuota_total": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Cuota Total"
          },
          "saldo_final": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Saldo Final"
          }
        },
        "type": "object",
        "required": [
          "numero_cuota",
          "fecha_vencimiento",
          "saldo_inicial",
          "amortizacion",
          "interes",
          "cuota_total",
          "saldo_final"
        ],
        "title": "CuotaSol"
      },
      "DecisionIn": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APROBADO",
              "RECHAZADO"
            ],
            "title": "Decision"
          },
          "comentario": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10,
            "title": "Comentario"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "comentario"
        ],
        "title": "DecisionIn",
        "description": "Decisión del analista sobre un resultado OBSERVADO de la regla. Solo APROBADO o RECHAZADO:\npor omisión del equipo (T1), el analista no devuelve la solicitud a SOL."
      },
      "ExpedienteSol": {
        "properties": {
          "cliente": {
            "$ref": "#/components/schemas/ClienteSol"
          },
          "condiciones": {
            "$ref": "#/components/schemas/CondicionesSol"
          },
          "politica": {
            "$ref": "#/components/schemas/PoliticaSol"
          },
          "calendario": {
            "$ref": "#/components/schemas/CalendarioSol"
          }
        },
        "type": "object",
        "required": [
          "cliente",
          "condiciones",
          "politica",
          "calendario"
        ],
        "title": "ExpedienteSol"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PoliticaSol": {
        "properties": {
          "tea": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Tea"
          },
          "amortizacion": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Amortizacion",
            "default": "FRANCES"
          }
        },
        "type": "object",
        "required": [
          "tea"
        ],
        "title": "PoliticaSol"
      },
      "RevocacionIn": {
        "properties": {
          "motivo": {
            "type": "string",
            "maxLength": 255,
            "minLength": 10,
            "title": "Motivo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "motivo"
        ],
        "title": "RevocacionIn"
      },
      "SituacionIn": {
        "properties": {
          "versionSolicitud": {
            "type": "integer",
            "maximum": 32767.0,
            "minimum": 1.0,
            "title": "Versionsolicitud"
          },
          "ingresoMensual": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Ingresomensual"
          },
          "deudaMensual": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Deudamensual"
          },
          "riesgo": {
            "type": "string",
            "enum": [
              "BUENO",
              "REGULAR",
              "ALTO"
            ],
            "title": "Riesgo"
          },
          "verificada": {
            "type": "boolean",
            "title": "Verificada"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "versionSolicitud",
          "ingresoMensual",
          "deudaMensual",
          "riesgo",
          "verificada"
        ],
        "title": "SituacionIn",
        "description": "Situación financiera del cliente que registra el analista; con ella COREDB corre la regla."
      },
      "SobreExpediente": {
        "properties": {
          "versionContrato": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Versioncontrato"
          },
          "idSolicitud": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "title": "Idsolicitud"
          },
          "versionSolicitud": {
            "type": "integer",
            "maximum": 32767.0,
            "minimum": 1.0,
            "title": "Versionsolicitud"
          },
          "idOperacion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{8,80}$",
            "title": "Idoperacion"
          },
          "idCorrelacion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "title": "Idcorrelacion"
          },
          "expediente": {
            "$ref": "#/components/schemas/ExpedienteSol"
          },
          "simulado": {
            "type": "boolean",
            "title": "Simulado",
            "default": false
          },
          "actorEnvio": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Actorenvio"
          }
        },
        "type": "object",
        "required": [
          "versionContrato",
          "idSolicitud",
          "versionSolicitud",
          "idOperacion",
          "idCorrelacion",
          "expediente"
        ],
        "title": "SobreExpediente",
        "description": "CR-INT-02: lo que SOL envía al pulsar «Guardar y enviar»."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
