{
  "openapi": "3.1.0",
  "info": {
    "title": "BNA · Evaluación Crediticia",
    "description": "Módulo 12 de la Línea de Créditos, sin base propia. Recibe el expediente de Solicitud (CR-INT-02) y lo registra en COREDB con su usuario de servicio; el analista consulta, registra la situación financiera (COREDB corre la regla RN-EVA-002-P) y decide los casos OBSERVADO con su propio token de COREDB, que Evaluación reenvía; el resultado final vuelve a Solicitud (CR-INT-03). Montos como texto decimal (\"500.00\").",
    "version": "1.0.0"
  },
  "paths": {
    "/salud": {
      "get": {
        "tags": [
          "Estado"
        ],
        "summary": "COREDB responde y el usuario de servicio inicia sesión",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/eva/applications": {
      "post": {
        "tags": [
          "CR-INT-02 Solicitud a Evaluación"
        ],
        "summary": "Recibir el expediente de una versión de solicitud",
        "description": "Registra la versión en COREDB y devuelve el acuse que SOL valida. COREDB reconoce la\nmisma versión con el mismo contenido (200, el mismo acuse), así que reenviar es seguro.",
        "operationId": "recibir_expediente_eva_applications_post",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "x-idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SobreExpediente"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "200": {
            "description": "Repetición: el mismo acuse"
          },
          "409": {
            "description": "IDEMPOTENCIA_CONFLICTO: la misma versión con otro contenido"
          },
          "422": {
            "description": "EXPEDIENTE_INCONSISTENTE, CLIENTE_NO_HABILITADO, CALENDARIO_INVALIDO o SOLICITUD_NO_ADMITIDA"
          }
        }
      }
    },
    "/eva/operations/{id_operacion}": {
      "get": {
        "tags": [
          "CR-INT-02 Solicitud a Evaluación"
        ],
        "summary": "Consultar la recepción de una operación",
        "description": "Evaluación no guarda las operaciones de SOL: responde 404 y SOL reenvía el expediente, que\nCOREDB reconoce por su versión y contenido sin registrarlo dos veces (devuelve el mismo acuse).",
        "operationId": "consultar_operacion_eva_operations__id_operacion__get",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id_operacion",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id Operacion"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Sin registro de la operación: SOL puede enviarla"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/eva/v1/solicitudes": {
      "get": {
        "tags": [
