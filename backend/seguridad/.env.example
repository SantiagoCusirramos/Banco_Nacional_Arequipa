# Solo para correr el módulo fuera del producto (backend/seguridad/run_local.sh). En el producto,
# ./bna up toma estos valores de .env. Generar valores aleatorios: openssl rand -hex 32
SEGURIDAD_SECRET_KEY=
# Usuario de servicio de COREDB del módulo SEGURIDAD y su secreto (POST /coredb/usuarios/servicios).
SEGURIDAD_COREDB_USUARIO=svc-seguridad
SEGURIDAD_COREDB_SECRETO=
# COREDB, a través del Bus de Servicios, y la credencial del módulo ante el Bus.
COREDB_URL=http://127.0.0.1:8018/bus/coredb
BUS_TOKEN=
