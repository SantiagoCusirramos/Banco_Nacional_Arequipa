  "components": {
    "schemas": {
      "ApplicationInput": {
        "properties": {
          "id_cliente": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Id Cliente"
          },
          "monto_solicitado": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Monto Solicitado"
          },
          "moneda": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Moneda"
          },
          "plazo_meses": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Plazo Meses"
          },
          "destino_credito": {
            "type": "string",
            "maxLength": 120,
            "minLength": 5,
            "title": "Destino Credito"
          },
          "fecha_base": {
            "type": "string",
            "format": "date",
            "title": "Fecha Base"
          },
          "pago_doble": {
            "type": "boolean",
            "title": "Pago Doble",
            "default": false
          },
          "garantias": {
            "items": {
              "$ref": "#/components/schemas/Guarantee"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Garantias"
          },
          "fiadores": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Fiadores"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id_cliente",
          "monto_solicitado",
          "moneda",
          "plazo_meses",
          "destino_credito",
          "fecha_base"
        ],
        "title": "ApplicationInput"
      },
      "DisableUser": {
        "properties": {
          "motivo": {
            "type": "string",
            "maxLength": 200,
            "minLength": 5,
            "title": "Motivo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "motivo"
        ],
        "title": "DisableUser"
      },
      "EvaluationResult": {
        "properties": {
          "idSolicitud": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "title": "Idsolicitud"
          },
          "versionSolicitud": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Versionsolicitud"
          },
          "idEvaluacion": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Idevaluacion"
          },
          "ronda": {
