# Configuración del producto integrado (compose.yaml).
#
# No hace falta copiar este archivo a mano: `./bna up` crea `.env` a partir de él y
# pone un valor aleatorio en cada variable vacía. `.env` no se versiona.
# Un valor que ya esté en `.env` nunca se cambia.

# ── Base integrada del CORE (servicio db) ───────────────────
CORE_DB_ROOT_PASSWORD=
CORE_DB_APP_PASSWORD=
CORE_DB_ADMIN_PASSWORD=
CORE_DB_SEGURIDAD_PASSWORD=

# ── COREDB ──────────────────────────────────────────────────
# Clave que firma sus tokens. Es distinta de la del CORE legado.
CORE_DB_JWT_CLAVE=
# Primer administrador, creado al arrancar si no hay ninguno.
BNA_ADMIN_USUARIO=admin
BNA_ADMIN_PASSWORD=

# ── Base auxiliar (servicio db-aux): `bna` legada y `bna_sol_mvp` ──
AUX_DB_ROOT_PASSWORD=
LEGADO_DB_PASSWORD=
SOL_DB_PASSWORD=

# ── CORE legado ─────────────────────────────────────────────
LEGADO_SECRET_KEY=

# ── SOL ─────────────────────────────────────────────────────
# Clave inicial de sus cuatro cuentas de demostración.
SOL_INITIAL_PASSWORD=
# Proveedores HTTP de SOL: en SIMULADO no se contactan, pero una pareja
# incompleta (solo URL o solo token) impide el arranque también en SIMULADO.
# En REAL hace falta la pareja URL/token completa de cada proveedor; si no se
# configura ninguna de las dos, se usa SOL_BUS_BASE_URL/SOL_BUS_TOKEN.
SOL_CAP_BASE_URL=
SOL_CAP_TOKEN=
SOL_EVA_BASE_URL=
SOL_EVA_TOKEN=
SOL_AUDIT_BASE_URL=
SOL_AUDIT_TOKEN=

# ── EVALUACIÓN (sin base propia: usa COREDB) ────────────────
# Secreto de su usuario de servicio en COREDB (svc-evaluacion). Lo crea coredb-init.
EVALUACION_COREDB_SECRETO=
# Token con el que SOL entrega expedientes (CR-INT-02). Cuando SOL pase a modo REAL,
# su SOL_BUS_TOKEN debe tener este mismo valor.
EVALUACION_TOKEN_SOL=
# Token para devolver el resultado a SOL (CR-INT-03): el SOL_EVA_CALLBACK_TOKEN de SOL.
EVALUACION_SOL_TOKEN_RESULTADOS=
# EVALUACION_SOL_URL no va aquí: vacía mientras SOL siga en modo SIMULADO (ver compose.yaml).

# ── DESEMBOLSO (sin base propia: usa COREDB) ────────────────
# Secreto de su usuario de servicio en COREDB (svc-desembolso). Lo crea coredb-init.
DESEMBOLSO_COREDB_SECRETO=

# ── CAPTACION (sin base propia: usa COREDB) ─────────────────
# Secreto de su usuario de servicio en COREDB (svc-captacion, módulo CLIENTES). Lo crea coredb-init.
CAPTACION_COREDB_SECRETO=
# Token con el que Solicitud de Crédito consulta las referencias (CR-INT-01).
CAP_SOL_TOKEN=
# Clave del HMAC de los códigos OTP (COREDB solo guarda el HMAC).
CAP_OTP_CLAVE=

# ── Bus de Servicios ────────────────────────────────────────
# Credencial de cada consumidor del Bus (cabecera X-Bus-Token): los puentes del
# frontend, el flujo de extremo a extremo (`./bna smoke`) y cada módulo que llama a
# COREDB, que solo se alcanza a través del Bus (fase 2). Cada módulo la recibe como BUS_TOKEN.
BUS_TOKEN_FRONTEND=
BUS_TOKEN_PRUEBAS=
BUS_TOKEN_CUENTAS=
BUS_TOKEN_TARJETAS=
BUS_TOKEN_CAPTACION=
BUS_TOKEN_EVALUACION=
BUS_TOKEN_DESEMBOLSO=

# ── Seguridad ───────────────────────────────────────────────
SEGURIDAD_SECRET_KEY=

# ── Puertos en esta máquina (solo 127.0.0.1) ────────────────
BNA_PUERTO_FRONTEND=3000
BNA_PUERTO_CORE_LEGADO=8000
BNA_PUERTO_CUENTAS=8001
BNA_PUERTO_TARJETAS=8002
BNA_PUERTO_SOL=8011
BNA_PUERTO_COREDB=8012
BNA_PUERTO_SEGURIDAD=8013
BNA_PUERTO_EVALUACION=8015
BNA_PUERTO_DESEMBOLSO=8016
BNA_PUERTO_CAPTACION=8017
BNA_PUERTO_BUS=8018
BNA_PUERTO_DB=3307
