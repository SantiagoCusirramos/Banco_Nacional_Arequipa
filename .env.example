# Configuración del producto integrado (compose.yaml).
#
# No hace falta copiar este archivo a mano: `./bna up` crea `.env` a partir de él y
# pone un valor aleatorio en cada variable vacía. `.env` no se versiona.
# Un valor que ya esté en `.env` nunca se cambia.

# ── Base integrada del CORE (servicio db) ───────────────────
CORE_DB_ROOT_PASSWORD=
CORE_DB_APP_PASSWORD=
CORE_DB_ADMIN_PASSWORD=
CORE_DB_SEGURIDAD_PASSWORD=

# ── COREDB ──────────────────────────────────────────────────
# Clave que firma sus tokens.
CORE_DB_JWT_CLAVE=
# Primer administrador, creado al arrancar si no hay ninguno.
BNA_ADMIN_USUARIO=admin
BNA_ADMIN_PASSWORD=

# ── SOL (sin base propia: usa COREDB) ───────────────────────
# Secreto de su usuario de servicio en COREDB (svc-sol). Lo crea coredb-init. Las personas
# entran a SOL con su usuario de COREDB (ASESOR, ADMINISTRADOR o AUDITOR).
SOL_COREDB_SECRETO=

# ── EVALUACIÓN (sin base propia: usa COREDB) ────────────────
# Secreto de su usuario de servicio en COREDB (svc-evaluacion). Lo crea coredb-init.
EVALUACION_COREDB_SECRETO=
# Token con el que SOL entrega expedientes (CR-INT-02); SOL lo recibe como SOL_EVA_TOKEN.
EVALUACION_TOKEN_SOL=
# Token para devolver el resultado a SOL (CR-INT-03); SOL lo recibe como SOL_EVA_CALLBACK_TOKEN.
EVALUACION_SOL_TOKEN_RESULTADOS=

# ── DESEMBOLSO (sin base propia: usa COREDB) ────────────────
# Secreto de su usuario de servicio en COREDB (svc-desembolso). Lo crea coredb-init.
DESEMBOLSO_COREDB_SECRETO=

# ── COBRANZA (sin base propia: usa COREDB) ──────────────────
# Secreto de su usuario de servicio en COREDB (svc-cobranza). Lo crea coredb-init.
COBRANZA_COREDB_SECRETO=

# ── BILLETERA: Chaski (sin base propia: usa COREDB) ─────────
# Secreto de su usuario de servicio en COREDB (svc-billetera). Lo crea coredb-init.
BILLETERA_COREDB_SECRETO=

# ── CAPTACION (sin base propia: usa COREDB) ─────────────────
# Secreto de su usuario de servicio en COREDB (svc-captacion, módulo CLIENTES). Lo crea coredb-init.
CAPTACION_COREDB_SECRETO=
# Token con el que Solicitud de Crédito consulta las referencias (CR-INT-01).
CAP_SOL_TOKEN=
# Clave del HMAC de los códigos OTP (COREDB solo guarda el HMAC).
CAP_OTP_CLAVE=

# ── Bus de Servicios ────────────────────────────────────────
# Credencial de cada consumidor del Bus (cabecera X-Bus-Token): los puentes del
# frontend, el flujo de extremo a extremo (`./bna smoke`) y cada módulo que llama a
# COREDB, que solo se alcanza a través del Bus (fase 2). Cada módulo la recibe como BUS_TOKEN.
BUS_TOKEN_FRONTEND=
BUS_TOKEN_PRUEBAS=
BUS_TOKEN_CUENTAS=
BUS_TOKEN_TARJETAS=
BUS_TOKEN_CAPTACION=
BUS_TOKEN_EVALUACION=
BUS_TOKEN_DESEMBOLSO=
BUS_TOKEN_COBRANZA=
BUS_TOKEN_ATM=
BUS_TOKEN_BILLETERA=
BUS_TOKEN_SEGURIDAD=
BUS_TOKEN_SOL=

# ── Seguridad (sin base propia: usa COREDB) ─────────────────
# Clave de los HMAC del código de un desafío y de los sellos de la bitácora (COREDB solo
# guarda los HMAC).
SEGURIDAD_SECRET_KEY=
# Secreto de su usuario de servicio en COREDB (svc-seguridad). Lo crea coredb-init.
SEGURIDAD_COREDB_SECRETO=

# ── Acceso desde otras máquinas (red local, Tailscale, ZeroTier) ────────────
# Dirección en la que se publican SOLO los tres puertos que usan las personas: el frontend,
# la pantalla del cajero (ATM) y la API de Chaski (la app del celular). Con 127.0.0.1 solo
# entra esta máquina. Con 0.0.0.0 entran las demás máquinas y los celulares de la red, por
# http://IP-de-esta-máquina:3000, :8019 y :8020. La base y los demás servicios siguen en 127.0.0.1.
BNA_IP_RED=127.0.0.1

# ── Puertos en esta máquina (solo 127.0.0.1) ────────────────
BNA_PUERTO_FRONTEND=3000
BNA_PUERTO_CUENTAS=8001
BNA_PUERTO_TARJETAS=8002
BNA_PUERTO_SOL=8011
BNA_PUERTO_COREDB=8012
BNA_PUERTO_SEGURIDAD=8013
BNA_PUERTO_COBRANZA=8014
BNA_PUERTO_EVALUACION=8015
BNA_PUERTO_DESEMBOLSO=8016
BNA_PUERTO_CAPTACION=8017
BNA_PUERTO_BUS=8018
BNA_PUERTO_ATM=8019
BNA_PUERTO_BILLETERA=8020
BNA_PUERTO_DB=3307
