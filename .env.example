# Configuración del producto integrado (compose.yaml).
#
# No hace falta copiar este archivo a mano: `./bna up` crea `.env` a partir de él y
# pone un valor aleatorio en cada variable vacía. `.env` no se versiona.
# Un valor que ya esté en `.env` nunca se cambia.

# ── Base integrada del CORE (servicio db) ───────────────────
CORE_DB_ROOT_PASSWORD=
CORE_DB_APP_PASSWORD=
CORE_DB_ADMIN_PASSWORD=
CORE_DB_SEGURIDAD_PASSWORD=

# ── COREDB ──────────────────────────────────────────────────
# Clave que firma sus tokens. Es distinta de la del CORE legado.
CORE_DB_JWT_CLAVE=
# Primer administrador, creado al arrancar si no hay ninguno.
BNA_ADMIN_USUARIO=admin
BNA_ADMIN_PASSWORD=

# ── Base auxiliar (servicio db-aux): `bna` legada y `bna_sol_mvp` ──
AUX_DB_ROOT_PASSWORD=
LEGADO_DB_PASSWORD=
SOL_DB_PASSWORD=

# ── CORE legado ─────────────────────────────────────────────
LEGADO_SECRET_KEY=

# ── SOL ─────────────────────────────────────────────────────
# Clave inicial de sus cuatro cuentas de demostración.
SOL_INITIAL_PASSWORD=

# ── Seguridad ───────────────────────────────────────────────
SEGURIDAD_SECRET_KEY=

# ── Puertos en esta máquina (solo 127.0.0.1) ────────────────
BNA_PUERTO_FRONTEND=3000
BNA_PUERTO_CORE_LEGADO=8000
BNA_PUERTO_CUENTAS=8001
BNA_PUERTO_SOL=8011
BNA_PUERTO_COREDB=8012
BNA_PUERTO_SEGURIDAD=8013
BNA_PUERTO_DB=3307
