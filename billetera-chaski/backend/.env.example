# Para correr la API fuera de compose (npm start). En el producto, compose y Kubernetes
# ponen estas variables; ver el README.
# COREDB, a través del Bus de Servicios, y la credencial de Chaski ante el Bus.
COREDB_URL=http://127.0.0.1:8018/bus/coredb
BUS_TOKEN=
# Usuario de servicio de COREDB del módulo BILLETERA (lo crea el arranque de COREDB).
CHASKI_COREDB_USUARIO=svc-billetera
CHASKI_COREDB_SECRETO=
PORT=3000
