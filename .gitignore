# ============================================================
# BNA — .gitignore global
# Cubre: Python (backend), Node/Next.js (frontend), Docker
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Entornos virtuales
venv/
.venv/
env/
.env/
ENV/

# Distribución / empaquetado
dist/
build/
*.egg-info/
.eggs/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# mypy / ruff
.mypy_cache/
.ruff_cache/

# Alembic (versiones generadas no se ignoran, solo el cache)
# (no agregar migrations/ aquí)

# ── Node / Next.js ──────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
.next/
out/
/build

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# ── Variables de entorno ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
# Excepción: el template sí se versiona
!.env.example

# ── Docker ──────────────────────────────────────────────────
# Volúmenes y datos locales de contenedores
docker-data/
mysql-data/

# ── Sistema operativo ───────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── IDEs / editores ─────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
