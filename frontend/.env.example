# Copiar como frontend/.env.local, que no se versiona.
# Direcciones de los servicios, vistas desde el servidor de Next.js. El navegador
# nunca las usa: llama a /api/core, /api/cuenta y /api/tarjeta, que reenvían desde el servidor.
COREDB_URL=http://127.0.0.1:8012
CUENTAS_GATEWAY_URL=http://127.0.0.1:8001/api/v1/cuentas
TARJETAS_GATEWAY_URL=http://127.0.0.1:8002/api/v1/tarjetas
# Las variables del módulo SOL están en .env.sol.example.
# Cobranza (/api/cobranza): las claves X-API-Key son las que ./bna up generó en el .env
# de la raíz (COBRANZA_API_KEY_LEER y COBRANZA_API_KEY_INTEGRACION); cópialas de ahí.
COBRANZA_URL=http://127.0.0.1:8014
COBRANZA_API_KEY_LEER=
COBRANZA_API_KEY_INTEGRACION=
