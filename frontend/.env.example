# Copiar como frontend/.env.local, que no se versiona.
# Direcciones de los servicios, vistas desde el servidor de Next.js. El navegador
# nunca las usa: llama a /api/core y /api/cuenta, que reenvían desde el servidor.
COREDB_URL=http://127.0.0.1:8012
CUENTAS_GATEWAY_URL=http://127.0.0.1:8001/api/v1/cuentas
# Las variables del módulo SOL están en .env.sol.example.
