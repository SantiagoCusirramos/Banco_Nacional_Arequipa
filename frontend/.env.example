# Copiar como frontend/.env.local, que no se versiona.
# Direcciones de los servicios, vistas desde el servidor de Next.js. El navegador
# nunca las usa: llama a los puentes /api/*, que reenvían desde el servidor.
# Aquí apuntan directo a los puertos de ./bna up; en el producto, compose las apunta al Bus.
COREDB_URL=http://127.0.0.1:8012
CUENTAS_GATEWAY_URL=http://127.0.0.1:8001/api/v1/cuentas
TARJETAS_GATEWAY_URL=http://127.0.0.1:8002/api/v1/tarjetas
# Las variables del módulo SOL están en .env.sol.example.
COBRANZA_GATEWAY_URL=http://127.0.0.1:8014
CAPTACION_GATEWAY_URL=http://127.0.0.1:8017/api/v1/captacion
EVALUACION_GATEWAY_URL=http://127.0.0.1:8015/eva/v1
DESEMBOLSO_GATEWAY_URL=http://127.0.0.1:8016/api/v1
