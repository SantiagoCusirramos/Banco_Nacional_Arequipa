# Copiar estas variables a frontend/.env.local (conservar otras existentes).
# URL solo del lado servidor: SOL a través del Bus (con BUS_TOKEN, la credencial del frontend).
SOL_GATEWAY_URL=http://127.0.0.1:8018/bus/sol/sol
# Activar cuando Next.js se sirva por HTTPS. En localhost HTTP dejar false.
SOL_COOKIE_SECURE=false
# Opcional: origen público exacto (sin ruta) si un proxy TLS delante de Next cambia el
# esquema. Sin ella, el proxy acepta escrituras cuyo Origin coincide con el Host recibido.
# SOL_PUBLIC_ORIGIN=https://bna.example
