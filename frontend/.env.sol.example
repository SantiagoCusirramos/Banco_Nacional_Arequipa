# Copiar estas variables a frontend/.env.local (conservar otras existentes).
# URL solo del lado servidor. /gateway/sol es el Bus SIMULADO de la demo.
SOL_GATEWAY_URL=http://127.0.0.1:8011/gateway/sol
# Activar cuando Next.js se sirva por HTTPS. En localhost HTTP dejar false.
SOL_COOKIE_SECURE=false
