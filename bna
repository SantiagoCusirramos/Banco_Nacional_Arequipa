#!/usr/bin/env bash
# Órdenes del producto integrado del BNA. Requiere Docker con Compose 2.20 o superior.
# En Windows: Git Bash o WSL2.
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$RAIZ"

# Proyecto de Compose: sus contenedores, redes y volúmenes son solo suyos, y `down -v` solo
# toca los de este proyecto. Por omisión `bna`; `./bna test` usa uno propio por corrida.
BNA_PROYECTO="${BNA_PROYECTO:-bna}"
case "$BNA_PROYECTO" in
  [a-z0-9]*) ;;
  *) echo "BNA_PROYECTO debe empezar con una letra minúscula o un dígito: $BNA_PROYECTO" >&2; exit 2 ;;
esac
case "$BNA_PROYECTO" in
  *[!a-z0-9_-]*) echo "BNA_PROYECTO solo admite minúsculas, dígitos, - y _: $BNA_PROYECTO" >&2; exit 2 ;;
esac
export BNA_PROYECTO COMPOSE_PROJECT_NAME="$BNA_PROYECTO"

ESPERA_SEGUNDOS="${BNA_ESPERA_SEGUNDOS:-600}"

ayuda() {
  cat <<'TEXTO'
Uso: ./bna <orden>

  up              Crea .env si falta, construye las imágenes, levanta todo y
                  espera a que cada servicio esté sano
  down            Detiene y elimina los contenedores; conserva los datos
  down -v         Detiene, elimina los contenedores y elimina también los volúmenes
  reset           Elimina también los volúmenes y vuelve a levantar todo desde cero
  ps              Estado de los servicios
  logs [servicio] Registros, en vivo
  smoke           Flujo de extremo a extremo contra el producto levantado
  demo            Flujo de la demo del profesor (cliente, cuenta, tarjeta, ATM, Chaski, bloqueo); deja los datos
  test            Todas las suites de pruebas, en contenedores, y el flujo, en un
                  proyecto propio que elimina al terminar (no toca el de ./bna up)
  help            Esta ayuda

Variables (opcionales):

  BNA_PROYECTO        proyecto de Compose (por omisión bna). Con otro nombre, otra copia del
                      producto con sus propios contenedores, redes y volúmenes
  BNA_ETIQUETA_LOCAL  etiqueta de las imágenes bna/* (por omisión local)

  ./bna test usa un proyecto y una etiqueta propios por corrida y no publica puertos, así que
  varias corridas (por ejemplo, desde dos worktrees) pueden ir a la vez. Ver CONTRIBUTING.md.

En Kubernetes, sobre un clúster local de kind con el nombre del proyecto (requiere kind y kubectl):

  k8s-up          Crea el clúster si falta, carga las imágenes, aplica el Secret
                  generado desde .env y despliega k8s/overlays/local
  k8s-smoke       El mismo flujo de extremo a extremo, dentro del clúster
  k8s-ps          Pods y servicios
  k8s-down        Elimina el clúster y la red de Docker `kind`, si nada más la usa

Con make: `make up`, `make test`, etc.
TEXTO
}

compose() { docker compose "$@"; }

# --remove-orphans: también baja los contenedores de servicios que ya no están en
# compose.yaml (el CORE legado y su base, eliminados en #125, en una instalación anterior).
bajar() { compose down --remove-orphans "$@"; }

# Valor de una variable: el del entorno si está definida; si no, el de .env.
valor() {
  if [ -n "${!1:-}" ]; then
    printf '%s\n' "${!1}"
  else
    grep -E "^$1=" .env | tail -n 1 | cut -d= -f2-
  fi
}

revisar_docker() {
  docker compose version >/dev/null 2>&1 || {
    echo "No se encontró Docker con Compose. Instale Docker y vuelva a intentar." >&2
    exit 1
  }
  docker info >/dev/null 2>&1 || {
    echo "Docker no responde. Inícielo y vuelva a intentar." >&2
    exit 1
  }
}

# Espera a que cada servicio esté sano y a que los de arranque (-init) terminen bien.
esperar() {
  local limite=$((SECONDS + ESPERA_SEGUNDOS)) pendientes ids id servicio estado salud salida
  while :; do
    pendientes=""
    ids="$(compose ps -aq)"
    [ -n "$ids" ] || { echo "No hay contenedores del producto." >&2; return 1; }
    for id in $ids; do
      read -r servicio estado salud salida < <(docker inspect --format \
        '{{index .Config.Labels "com.docker.compose.service"}} {{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}sin-sonda{{end}} {{.State.ExitCode}}' "$id")
      case "$servicio:$estado:$salud" in
        *-init:exited:*)
          if [ "$salida" != 0 ]; then
            echo "El servicio $servicio terminó con error:" >&2
            compose logs --tail=30 "$servicio" >&2
            return 1
          fi ;;
        *:running:healthy) ;;
        *:exited:*|*:dead:*)
          echo "El servicio $servicio se detuvo:" >&2
          compose logs --tail=30 "$servicio" >&2
          return 1 ;;
        *) pendientes="$pendientes $servicio" ;;
      esac
    done
    [ -z "$pendientes" ] && return 0
    if [ "$SECONDS" -ge "$limite" ]; then
      echo "Tras ${ESPERA_SEGUNDOS} s siguen sin estar sanos:$pendientes" >&2
      echo "Revise con: ./bna logs <servicio>" >&2
      return 1
    fi
    printf '\r  esperando:%-60s' "$pendientes"
    sleep 3
  done
}

resumen() {
  printf '\r%-75s\n' "Todos los servicios están sanos."
  case ":${COMPOSE_FILE:-}:" in
    *:compose.sin-puertos.yaml:*)
      echo "  Proyecto $BNA_PROYECTO en modo prueba: sin puertos en esta máquina."
      return 0 ;;
  esac
  cat <<TEXTO

  Frontend          http://localhost:$(valor BNA_PUERTO_FRONTEND)
  Solicitud crédito http://localhost:$(valor BNA_PUERTO_FRONTEND)/solicitud-credito
  Bus de Servicios  http://127.0.0.1:$(valor BNA_PUERTO_BUS)/docs
  COREDB (API)      http://127.0.0.1:$(valor BNA_PUERTO_COREDB)/docs
  CUENTAS           http://127.0.0.1:$(valor BNA_PUERTO_CUENTAS)/docs
  TARJETAS          http://127.0.0.1:$(valor BNA_PUERTO_TARJETAS)/docs
  SOL               http://127.0.0.1:$(valor BNA_PUERTO_SOL)/docs
  CAPTACION         http://127.0.0.1:$(valor BNA_PUERTO_CAPTACION)/docs
  Captación (asesor) http://localhost:$(valor BNA_PUERTO_FRONTEND)/captacion
  Cobranza          http://127.0.0.1:$(valor BNA_PUERTO_COBRANZA)/docs
                    Pantalla: http://localhost:$(valor BNA_PUERTO_FRONTEND)/pagar-cuota
  Seguridad         http://127.0.0.1:$(valor BNA_PUERTO_SEGURIDAD)
  Evaluación        http://localhost:$(valor BNA_PUERTO_FRONTEND)/evaluacion
                    API: http://127.0.0.1:$(valor BNA_PUERTO_EVALUACION)/docs
  Desembolso        http://localhost:$(valor BNA_PUERTO_FRONTEND)/desembolso
                    API: http://127.0.0.1:$(valor BNA_PUERTO_DESEMBOLSO)/docs
  Cajero (ATM)      http://127.0.0.1:$(valor BNA_PUERTO_ATM)
                    API: http://127.0.0.1:$(valor BNA_PUERTO_ATM)/docs
  Billetera Chaski  http://127.0.0.1:$(valor BNA_PUERTO_BILLETERA)/api/salud
  MySQL (CORE)      127.0.0.1:$(valor BNA_PUERTO_DB)

  Administrador de COREDB: usuario $(valor BNA_ADMIN_USUARIO); su contraseña está en
  .env (BNA_ADMIN_PASSWORD), junto con las demás claves generadas.
  Para comprobar el producto: ./bna smoke
TEXTO
}

levantar() {
  revisar_docker
  scripts/generar_env.sh "$RAIZ"
  compose up -d --build
  esperar
  resumen
}

humo() {
  [ -f .env ] || { echo "No hay .env: ejecute primero ./bna up" >&2; exit 1; }
  # Corre en el contenedor del Bus: llega a los módulos por el Bus y al frontend por la red `canales`.
  # MSYS_NO_PATHCONV: en Git Bash (Windows) evita que /tmp/... se convierta en una ruta de Windows;
  # esas rutas son del contenedor. Fuera de Git Bash no tiene efecto.
  MSYS_NO_PATHCONV=1 compose exec -T \
    -e E2E_BUS=http://127.0.0.1:8018 \
    -e BUS_TOKEN="$(valor BUS_TOKEN_PRUEBAS)" \
    -e BNA_ADMIN_USUARIO="$(valor BNA_ADMIN_USUARIO)" \
    -e BNA_ADMIN_PASSWORD="$(valor BNA_ADMIN_PASSWORD)" \
    -e EVALUACION_TOKEN_SOL="$(valor EVALUACION_TOKEN_SOL)" \
    -e CAP_SOL_TOKEN="$(valor CAP_SOL_TOKEN)" \
    -e E2E_SENSIBLES=/tmp/bna-e2e-sensibles \
    bus python - < scripts/flujo_e2e.py
  revisar_registros
}

# P-1: ningún registro de contenedor guarda un documento, celular, PIN, clave o token de la
# corrida. El flujo deja esos valores en el contenedor del Bus; aquí se buscan sin mostrarlos.
revisar_registros() {
  local valores hallados
  valores="$(mktemp)"
  MSYS_NO_PATHCONV=1 compose exec -T bus sh -c 'cat /tmp/bna-e2e-sensibles && rm -f /tmp/bna-e2e-sensibles' > "$valores"
  if [ ! -s "$valores" ]; then
    rm -f "$valores"
    echo "  FALLA  El flujo no dejó la lista de datos sensibles de la corrida." >&2
    exit 1
  fi
  hallados="$(compose logs --no-color 2>&1 | grep -wFf "$valores" | cut -d'|' -f1 | sort | uniq -c || true)"
  local revisados
  revisados="$(wc -l < "$valores")"
  rm -f "$valores"
  if [ -n "$hallados" ]; then
    echo "  FALLA  Datos sensibles de la corrida en los registros (líneas por servicio):" >&2
    echo "$hallados" >&2
    exit 1
  fi
  echo "  ok  registros: ninguno de los $revisados documentos, celulares, PIN, claves y tokens de la corrida"
}

# Flujo de la demo pedido por el profesor (scripts/flujo_profesor.py). A diferencia de `smoke`, deja
# los datos en la base y los muestra (incluidos PIN y celulares de prueba) para repetir la demo a mano.
demo() {
  [ -f .env ] || { echo "No hay .env: ejecute primero ./bna up" >&2; exit 1; }
  MSYS_NO_PATHCONV=1 compose exec -T \
    -e E2E_BUS=http://127.0.0.1:8018 \
    -e BUS_TOKEN="$(valor BUS_TOKEN_PRUEBAS)" \
    -e BNA_ADMIN_USUARIO="$(valor BNA_ADMIN_USUARIO)" \
    -e BNA_ADMIN_PASSWORD="$(valor BNA_ADMIN_PASSWORD)" \
    bus python - < scripts/flujo_profesor.py
}

orden="${1:-help}"
[ $# -gt 0 ] && shift
case "$orden" in
  up) levantar ;;
  down) bajar "$@" ;;
  reset)
    revisar_docker
    bajar -v
    levantar ;;
  ps) compose ps -a ;;
  logs) compose logs -f --tail=100 "$@" ;;
  smoke) humo ;;
  demo) demo ;;
  test) exec scripts/pruebas.sh "$@" ;;
  k8s-up|k8s-smoke|k8s-ps|k8s-down) exec scripts/k8s.sh "${orden#k8s-}" ;;
  help|-h|--help) ayuda ;;
  *)
    echo "Orden desconocida: $orden" >&2
    ayuda >&2
    exit 2 ;;
esac
